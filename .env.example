# APP_URL: Public URL where TraceRoots is hosted (used for QR tracking URLs).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret for HMAC-SHA256 session & test payment signing (min 32 chars in production).
SESSION_SECRET="replace_with_32_byte_cryptographic_secret"

# RAZORPAY PAYMENT CONFIGURATION (Server-side only — never expose RAZORPAY_KEY_SECRET in client code)
# Leave empty in local development to use the clearly marked TraceRoots Test Payment Sandbox.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# GEOCODING CONFIGURATION (Optional — server-side reverse geocoding proxy)
# Supports Google Maps Geocoding API key or OpenCage key; falls back cleanly to Nominatim/manual entry if unset.
GEOCODING_API_KEY=""
GEOCODING_PROVIDER="nominatim"

# OPTIONAL NOTIFICATION PROVIDERS (Server-side Email / SMS)
SMTP_WEBHOOK_URL=""
SMS_WEBHOOK_URL=""

# ADMIN BOOTSTRAP EMAIL (Optional — grants administrator access only to this verified email on seed)
ADMIN_BOOTSTRAP_EMAIL="admin@demo.traceroots.in"

# GEMINI_API_KEY (Platform default)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
